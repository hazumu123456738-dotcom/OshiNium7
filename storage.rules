rules_version = '2';

// ============================================================================
// OshiNium Firebase Storage セキュリティルール
// ----------------------------------------------------------------------------
// ★ このファイルはアプリのコードからは自動的に反映されません。
//   Firebaseコンソールの「Storage」→「Rules」タブに貼り付けるか、
//   `firebase deploy --only storage`（Firebase CLI）でデプロイしてください。
//   このセッションからは直接デプロイできないため、内容の確認後、必ずご自身でデプロイをお願いします。
//   ★ このファイルが存在しない・デプロイされていない間は、Storageのアクセス制御が
//     未設定（多くの場合は全拒否のデフォルト、あるいはプロジェクト作成時のテストモード＝全許可）
//     のいずれかになっている可能性があり、後者の場合は誰でも他人の画像を上書き・削除できる
//     状態になっているおそれがある。必ず内容を確認の上、最優先でデプロイすること。
//
// ★ アップロード先パスは ImageStorageService.swift の実装に合わせている：
//   - profileImages/{uid}/{fileName}      … プロフィールアイコン（本人のみ書き込み可）
//   - postMedia/{uid}/{fileName}          … 投稿の画像・動画（本人のみ書き込み可）
//   - diaryMedia/{uid}/{fileName}         … 思い出日記の画像（本人のみ書き込み可）
//   - expenseMedia/{uid}/{fileName}       … 推し活費用シミュレーターの画像（本人のみ書き込み可）
//   - venueReportMedia/{uid}/{fileName}   … 会場口コミの画像（本人のみ書き込み可）
//   - events/{eventId}/{fileName}         … イベント画像（Firestore側でイベントに作成者フィールドが
//                                            無いため、firestore.rulesと同じ理由でメンバー全員に書き込みを許可）
//   - chatMedia/{groupId}/{fileName}      … チャットの画像・動画（グループメンバー限定はStorageルール
//                                            単体では判定できないため、firestore.rulesのmessages create
//                                            ルール側で担保する。ここでは署名済みユーザーであることのみ課す）
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ★ アップロードサイズの上限（1ファイルあたり25MB）。
    //   動画投稿（postMedia）も含めて、際限のないアップロードを防ぐ
    function isWithinSizeLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // ── プロフィールアイコン ──────────────────────────────────
    match /profileImages/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isWithinSizeLimit();
    }

    // ── 投稿（画像・動画） ────────────────────────────────────
    match /postMedia/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isWithinSizeLimit();
    }

    // ── 思い出日記の画像（本人のみ） ──────────────────────────
    match /diaryMedia/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isWithinSizeLimit();
    }

    // ── 推し活費用シミュレーターの画像（本人のみ） ────────────
    match /expenseMedia/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isWithinSizeLimit();
    }

    // ── 会場口コミの画像（本人のみ書き込み。口コミ自体は匿名表示だが、
    //   アップロード経路の悪用防止のため本人確認は必要） ──────────
    match /venueReportMedia/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) && isWithinSizeLimit();
    }

    // ── イベント画像 ──────────────────────────────────────────
    // ★ firestore.rulesのevents/privateEventsと同じく、現状のアプリには
    //   イベントごとの作成者フィールドが無く、グループメンバー全員が編集できる
    //   「共有カレンダー」という仕様に合わせている（将来createdByUid等を追加したら見直す）
    // ★ 2026/08/19訂正：2026/08/18時点では「Storage↔Firestoreのcross-service連携が
    //   未設定」と判断していたが、これは誤りだった。firestore.exists()/get()自体は
    //   GA機能で有効化操作は不要と一次情報で確認済み（chatMediaで実際に
    //   `firebase deploy --dry-run`のコンパイル検証に成功している）。今回この
    //   パスを対象外にしているのは連携の問題ではなく、eventIdだけでは
    //   community(events)/private(privateEvents)のどちらの予定かStorage側から
    //   判別できず、両方に対応する判定には1回のルール評価で許容される
    //   Firestoreドキュメント参照数(最大2件)を超える可能性が高いため（★残存リスク：
    //   グループ非メンバーでも書き込み自体は可能。ただしfirestore.rules側で
    //   メッセージ・イベント"ドキュメント"の作成はisGroupMemberで別途守られているため、
    //   アップロードされたファイルが実際に使われる導線には別途保護がある）
    match /events/{eventId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isWithinSizeLimit();
    }

    // ── チャット画像 ──────────────────────────────────────────
    // ★ 2026/08/19：/ult監査を機に一次情報(firebase.google.com/docs/storage/security/
    //   rules-conditions)を再確認したところ、firestore.exists()/get()自体はGA機能で
    //   有効化操作は不要、初回ルール保存時にコンソール上で権限確認のプロンプトが
    //   出るだけと判明した。2026/08/18の失敗("Unexpected 'firestore'")は連携が
    //   未設定だったからではなく、別の構文ミス(または前後の記述の巻き添え)だった
    //   可能性が高い。パスに直接groupIdが含まれるこのルールは1回のFirestore参照で
    //   完結する(ドキュメント数上限2件以内)ため、ここに限定して再挑戦する。
    //   events/{eventId}側はcommunity/privateEventsのどちらに属すか
    //   Storageパスだけでは判別できず、判定に3回以上のFirestore参照が必要になり
    //   複雑になりすぎるため、今回はchatMediaのみ対応する
    match /chatMedia/{groupId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isWithinSizeLimit() &&
        firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // ── その他すべて：デフォルト拒否 ──────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
