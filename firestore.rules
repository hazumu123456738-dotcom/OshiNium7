rules_version = '2';

// ============================================================================
// OshiNium Firestore セキュリティルール
// ----------------------------------------------------------------------------
// ★ このファイルはアプリのコードからは自動的に反映されません。
//   Firebaseコンソールの「Firestore Database」→「ルール」タブに貼り付けるか、
//   `firebase deploy --only firestore:rules`（Firebase CLI）でデプロイしてください。
//   このセッションからは直接デプロイできないため、内容の確認後、必ずご自身でデプロイをお願いします。
//
// ★ 設計方針:
//   - クライアント側の実装（各ViewModelでの絞り込み）はあくまでUI都合のガードであり、
//     本当の意味での安全性はこのルールが担保する。ここに書かれていない操作はすべて拒否される
//     （Firestoreルールはデフォルトで全拒否）。
//   - 「本人のデータ」はuidの一致で判定する、「グループの権限」はmembersサブコレクションの
//     roleフィールドを読みに行くget()で判定する、という2つの基本パターンを組み合わせている。
//   - 通信経路の暗号化はFirestore/Firebaseの標準機能（HTTPS/TLS）によって常に有効であり、
//     このルール自体が担うものではない。メッセージ本文そのもののエンド・ツー・エンド暗号化は
//     今回のスコープ外（別途の大規模な設計変更が必要なため、まずは権限まわりの安全性を優先した）
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共通ヘルパー ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ★ 通報を受けて手動で利用制限したユーザーかどうか。restrictedUsers/{uid}という
    //   ドキュメントが「存在するだけ」で判定するシンプルな仕組みで、中身のフィールドは見ない。
    //   このコレクションはクライアントから一切書き込めない（下の match ブロックで
    //   read/writeともにfalse）ため、本人が自分で解除することはできず、
    //   Firebaseコンソールから手動で作成・削除する運用にする
    //   （通報が閾値に達したら自動停止、ではなく、必ず人間が内容を確認してから
    //   手動で制限する設計。自動停止は「通報を大量に送りつけて無実の相手を止める」
    //   荒らし行為に悪用されやすく、通報の中身をサーバー側で信頼して検証する仕組み
    //   （Cloud Functions等）が無い現状では特に危険なため採用しない）
    function isRestricted() {
      return exists(/databases/$(database)/documents/restrictedUsers/$(request.auth.uid));
    }

    // ★ 指定グループでのrequest.auth.uidの権限（owner/admin/member）。
    //   memberドキュメントが無い場合は"member"として扱う（クライアント側のGroupRole既定値と合わせる）
    function myGroupRole(groupId) {
      let memberPath = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return exists(memberPath)
        ? (get(memberPath).data.keys().hasAny(['role']) ? get(memberPath).data.role : 'member')
        : 'member';
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() && myGroupRole(groupId) in ['owner', 'admin'];
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && myGroupRole(groupId) == 'owner';
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // ── restrictedUsers/{uid}（手動での利用制限） ─────────────────
    // ★ 存在するだけで判定に使う。クライアントからは読み書きどちらも一切できない
    //   （Firebaseコンソールから、通報内容を確認した上で手動でドキュメントを作成・削除する運用）
    match /restrictedUsers/{uid} {
      allow read, write: if false;
    }

    // ── users/{uid} ──────────────────────────────────────────────
    // ★ プロフィールは他ユーザーからも閲覧される（フォロー一覧・チャット送信者名など）ため読み取りは
    //   認証済みユーザーなら誰でも可。書き込みは本人のみ
    match /users/{uid} {
      allow read: if isSignedIn();

      // ★ 2026/08/11：以前は`allow write: if isSelf(uid);`だけで、本人ならどんなフィールドでも
      //   自由に書き換えられてしまっていた。isPremiumSubscriber・pointsという金銭価値のある
      //   フィールドまで無制限に書けたため（UserSettingsViewModel.saveSettingsが書く
      //   プロフィール項目一覧と、それ以外の特別な更新パターンを列挙する形に締め直した。

      // ★ プロフィールの新規作成：UserSettingsViewModel.saveSettingsが書く項目の部分集合のみ許可。
      //   points/isPremiumSubscriber/activeThemeId等は作成時点では含められない
      //   （新規ドキュメントはこれらのフィールドを持たない状態から始まる）
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'iconURL', 'birthday', 'snsLinks', 'defaultNotifyMinutes',
          'isPrivateAccount', 'commentPermission', 'dmPermission',
          'liveNotifyEnabled', 'chatNotifyEnabled', 'followNotifyEnabled', 'postNotifyEnabled'
        ]);

      // ★ プロフィールの更新：以下のどれか1パターンの形の更新だけを許可する。
      //   ① 自己申告してよい安全なプロフィール項目（UserSettingsViewModel.saveSettings）。
      //     何個でも同時に変更してよい
      //   ② activeThemeIdだけの更新（着せ替え適用・ThemeManager.applyTheme）
      //   ③ unlockedThemeIdsへの追加のみ（テーマ交換。他人を外す・他フィールド変更は不可）
      //   ④ themeToolUnlockedをtrueにするだけの更新（ツール解放。一度trueにしたら戻せない）
      //   ⑤’ points＋unlockedThemeIds、またはpoints＋themeToolUnlockedを同じ1回の書き込みで
      //     同時に減らす／付与する（ポイント消費とテーマ・ツール付与を1回のFirestore書き込みに
      //     まとめることで原子性を持たせる。ThemeManager.unlock/unlockTool参照。
      //     途中でクラッシュ・通信断が起きても「ポイントだけ減って何も手に入らない」状態には
      //     ならない、②③④とは別に必ずpointsが減る方向にしか動かせない）
      //   ⑤ pointsのみの、1回あたり±500に収まる更新
      //     （★既知の残存リスク：FieldValue.increment()の結果値しかルール側から見えず、
      //     本当に正当な行動報酬による加算かはここでは検証できない。真に安全にするには
      //     ポイント付与処理自体をCloud Functions側に移す必要がある。現状はサーバー側の
      //     付与処理が存在しないため、1回の被害を最大500ptに抑える緩和策に留めている）
      //   ★ isPremiumSubscriberはここには含まれない＝クライアントからは一切書き込めない
      //     （2026/08/11変更）。functions/index.jsのverifyPremiumPurchase/
      //     appStoreNotificationsが、Apple公式ライブラリでStoreKitの署名付きトランザクションを
      //     独立に検証した上で、Admin SDK（このルールを経由しない特権アクセス）経由でのみ
      //     書き込む。以前はここに「他フィールドと同時変更できない」という緩和策だけの
      //     単体書き込み許可があったが、それでも「本物の購入なしにtrueへ書き換える」こと自体は
      //     防げていなかった。今はクライアントからの直接書き込みを完全に禁止している
      allow update: if isSelf(uid) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'bio', 'iconURL', 'birthday', 'snsLinks', 'defaultNotifyMinutes',
            'isPrivateAccount', 'commentPermission', 'dmPermission',
            'liveNotifyEnabled', 'chatNotifyEnabled', 'followNotifyEnabled', 'postNotifyEnabled'
          ])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeThemeId'])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlockedThemeIds']) &&
          request.resource.data.unlockedThemeIds.hasAll(resource.data.get('unlockedThemeIds', []))
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['themeToolUnlocked']) &&
          request.resource.data.themeToolUnlocked == true
        ) ||
        (
          // ★ ポイント消費とテーマ付与を1回の書き込みに原子的にまとめる版（ThemeManager.unlock）
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'unlockedThemeIds']) &&
          request.resource.data.points is int &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= resource.data.get('points', 0) &&
          request.resource.data.points >= resource.data.get('points', 0) - 500 &&
          request.resource.data.unlockedThemeIds.hasAll(resource.data.get('unlockedThemeIds', []))
        ) ||
        (
          // ★ ポイント消費とツール解放を1回の書き込みに原子的にまとめる版（ThemeManager.unlockTool）
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'themeToolUnlocked']) &&
          request.resource.data.points is int &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= resource.data.get('points', 0) &&
          request.resource.data.points >= resource.data.get('points', 0) - 500 &&
          request.resource.data.themeToolUnlocked == true
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']) &&
          request.resource.data.points is int &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= resource.data.get('points', 0) + 500 &&
          request.resource.data.points >= resource.data.get('points', 0) - 500
        )
      );

      allow delete: if isSelf(uid);

      // ★ 自分が参加しているグループの一覧。本人だけが読み書きできるが、
      //   グループの削除（deleteGroupCompletely）に伴い"退出させられる"ケースも無いよう、
      //   このセッションでは他人のselectedGroups削除は行わない設計にしている
      match /selectedGroups/{groupId} {
        allow read, write: if isSelf(uid);
      }

      // ★ ブロックリストは本人だけが読み書きできる
      match /blockedUsers/{blockedUid} {
        allow read, write: if isSelf(uid);
      }

      // ★ ミュートリストも同様に本人だけが読み書きできる（相手には見えない一方的な設定）
      match /mutedUsers/{mutedUid} {
        allow read, write: if isSelf(uid);
      }

      // ★ FCMプッシュ通知トークン。users/{uid}本体は他ユーザーからも読める（プロフィール表示用）ため、
      //   誰でも読めてよいわけではないpush tokenは別のサブコレクションに分け、本人だけに限定する
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      // ★ カレンダーの「作り直し」レート制限用ログ(削除・作り直しの記録)。本人だけが読み書きできる
      match /calendarActivityLog/{docId} {
        allow read, write: if isSelf(uid);
      }

      // ★ 「今日の推し活占い」のポイント付与済みログ(2026/08/11追加)。docIdは日付(yyyy-MM-dd)。
      //   作成のみ許可し、更新・削除は常に不可にする。read,writeを丸ごと許可すると
      //   自分で削除して再作成できてしまい、1日1回のポイント付与制限をすり抜けられるため
      match /fortuneLog/{docId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid);
        allow update, delete: if false;
      }

      // ★ 承認待ち一覧で「承認済み」を10日間積み重ね表示し続けるための記録(2026/08/11追加)。
      //   docIdはeventId。何度承認しても上書きされるだけの軽い個人用キャッシュであり、
      //   fortuneLogのような不正防止上の懸念(悪用による連打)が無いため、本人に限り
      //   read/writeを丸ごと許可するシンプルな形にする
      match /approvalLog/{eventId} {
        allow read, write: if isSelf(uid);
      }

      // ★ 着せ替え（ポイント交換の自作テーマ）。ThemeManagerは常に自分自身のuidでしか
      //   startListeningを呼ばず、他人のテーマを読む機能も無いため本人限定でよい。
      //   （2026/08/11追加：このmatchブロックが無かったため、customThemesが
      //   ずっとデフォルト拒否になり着せ替え機能が実機で動作していなかった不具合を修正）
      match /customThemes/{themeId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── groups/{groupId} ─────────────────────────────────────────
    match /groups/{groupId} {
      // ★ 個別ドキュメントの取得(get)は招待リンク経由の参加（joinGroup、IDを直接指定して取得）に
      //   必要なため、非公開グループでも許可する（UUIDのgroupId自体が実質的な招待コード）。
      //   一方、一覧・検索(list)では非公開グループを絶対に含めない。isPrivateがfalseの
      //   ドキュメントだけが対象になり、フィールド未設定のグループが誤って弾かれないよう、
      //   create時・自己修復時は必ずisPrivateを明示的に書き込む（GroupViewModel参照）。
      //   ★ クライアント側のGroupViewModel.loadCatalog()は必ずisPrivate==falseのwhereFieldと
      //   組み合わせて呼ぶこと（組み合わせないとFirestoreがlistクエリ全体を拒否する）
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.isPrivate == false;
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      // ★ 詳細情報（コンセプト等）の編集は現状どのメンバーでも可能というアプリの仕様に合わせる
      allow update: if isGroupMember(groupId);
      // ★ グループ本体の削除はオーナーのみ
      allow delete: if isGroupOwner(groupId);

      match /members/{memberUid} {
        // ★ 公開グループのメンバー一覧は誰でも見られる（既存機能）が、非公開グループは
        //   メンバー自身にしか名簿を見せない（以前はisSignedIn()だけで、招待制グループの
        //   名簿も誰でも読めてしまっていた）
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/groups/$(groupId)).data.isPrivate != true || isGroupMember(groupId));

        // ★ 自分自身のmemberドキュメントは作成できるが、"role"を勝手に名乗ることはできない
        //   （グループ作成者本人がownerを名乗る場合のみ例外的に許可する）
        allow create: if isSelf(memberUid) &&
          (!request.resource.data.keys().hasAny(['role']) ||
            request.resource.data.role == 'member' ||
            (request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/groups/$(groupId)).data.createdByUid == request.auth.uid));

        // ★ 自分の表示名・アイコン更新はroleを変えない限り自由。role変更はオーナー・管理者のみ
        allow update: if (isSelf(memberUid) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
          isGroupAdmin(groupId);

        // ★ 自分の退出、またはオーナー・管理者によるメンバー削除
        allow delete: if isSelf(memberUid) || isGroupAdmin(groupId);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.senderUid == request.auth.uid && !isRestricted();
        // ★ 送信者本人、またはグループのオーナー・管理者（不適切な発言の削除）
        allow delete: if isSignedIn() &&
          (resource.data.senderUid == request.auth.uid || isGroupAdmin(groupId));
        // ★ ダブルタップのハートリアクション（likedBy）だけは、グループメンバーなら
        //   誰でも自分のuidを付け外しできる。本文・送信者などの改ざんは防ぐ
        allow update: if isGroupMember(groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
      }

      // ★ コミュニティチャット匿名版。固定の1部屋ではなく、メンバーなら誰でも自由に
      //   話題（トークルーム）を立てられ、他の人が立てたトークルームにも自由に
      //   参加・閲覧できる（掲示板のスレッド一覧に近い形）。
      //   creatorUidはモデレーション用（自分のトークルーム削除・管理者削除）にのみ保持し、
      //   UI上には表示しない
      match /anonymousTopics/{topicId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.creatorUid == request.auth.uid;
        // ★ メッセージ送信のたびにクライアントから lastMessageAt / messageCount を更新するため、
        //   その2つのフィールドだけの変更を許可する（タイトル・作成者の後からの改ざんは防ぐ）
        allow update: if isGroupMember(groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'messageCount']);
        // ★ 立てた本人、またはグループのオーナー・管理者が削除できる
        allow delete: if isSignedIn() &&
          (resource.data.creatorUid == request.auth.uid || isGroupAdmin(groupId));

        // senderUidはモデレーション用にドキュメントへ残すが、通常のmessagesと同じ
        // 権限モデル（本人 or 管理者が削除可）にする。グループメンバー限定である点も通常チャットと同じ
        match /messages/{messageId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId) && request.resource.data.senderUid == request.auth.uid && !isRestricted();
          allow delete: if isSignedIn() &&
            (resource.data.senderUid == request.auth.uid || isGroupAdmin(groupId));
          allow update: if false;
        }
      }

      // ★ コミュニティチャット公開版。匿名版と同じ「誰でも自由に話題（トークルーム）を
      //   立てられ、他の人が立てたトークルームにも自由に参加・閲覧できる」構造だが、
      //   発言者の名前・アイコンをそのまま表示する（推し活の友達を見つけるための場）。
      //   権限モデルは匿名版と同一（グループメンバー限定・本人or管理者が削除可）
      match /openTopics/{topicId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.creatorUid == request.auth.uid;
        allow update: if isGroupMember(groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'messageCount']);
        allow delete: if isSignedIn() &&
          (resource.data.creatorUid == request.auth.uid || isGroupAdmin(groupId));

        match /messages/{messageId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId) && request.resource.data.senderUid == request.auth.uid && !isRestricted();
          allow delete: if isSignedIn() &&
            (resource.data.senderUid == request.auth.uid || isGroupAdmin(groupId));
          allow update: if false;
        }
      }
    }

    // ── dmThreads/{threadId} ─────────────────────────────────────
    // ★ DMは相互フォローでなくても開始できる仕様（「DMリクエスト」機能。相手が相互フォロー
    //   でない場合はDM欄とは別に「DMリクエスト」として表示される、というアプリ側の意図的な設計）。
    //   そのためここでは相互フォローの強制は行わない。代わりに、ブロック関係だけは
    //   クライアント側のガード（DirectMessageThreadView.send()のisBlockedEitherWayチェック）
    //   に加えてサーバー側でも強制する。改造クライアントであっても、ブロックしている／されている
    //   相手とはメッセージを送受信できないようにする
    function isBlockedEitherWay(otherUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(otherUid))
        || exists(/databases/$(database)/documents/users/$(otherUid)/blockedUsers/$(request.auth.uid));
    }

    function otherParticipantFromResource() {
      return request.resource.data.participants[0] == request.auth.uid
        ? request.resource.data.participants[1]
        : request.resource.data.participants[0];
    }

    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function otherParticipantOfThread(threadId) {
      let participants = get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    // ★ 相手のusers/{uid}.dmPermissionが'none'ならDMスレッドの新規作成を拒否する。
    //   未設定の既存ユーザーは'everyone'扱い（後方互換）
    function recipientAcceptsDM(otherUid) {
      return get(/databases/$(database)/documents/users/$(otherUid)).data.get('dmPermission', 'everyone') != 'none';
    }

    match /dmThreads/{threadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      // ★ スレッドの新規作成（＝両者間で初めて送るメッセージ）時点でブロック関係・DM受信設定を確認する
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        !isBlockedEitherWay(otherParticipantFromResource()) &&
        recipientAcceptsDM(otherParticipantFromResource());
      // ★ 2通目以降のメッセージ送信でも、スレッド側のlastMessage/lastMessageAt/lastSenderUid
      //   （一覧のプレビュー）を更新する前に必ずブロック関係を確認する。以前はここにブロック
      //   チェックが無く、messagesサブコレクションへの本文書き込み自体は拒否されても、
      //   スレッド側のプレビューだけは更新できてしまい、ブロック直後の相手からの
      //   なりすましプレビューが一覧に表示され得た
      allow update: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        !isBlockedEitherWay(otherParticipant(resource.data.participants));
      // ★ DM一覧のスワイプ削除用。参加者本人であれば、スレッド（一覧上の表示）を削除できる。
      //   messagesサブコレクションはこの削除では消えず残るが、resource.data.participantsに
      //   基づくread/create/deleteの各ルールにより、スレッド自体が消えた後は
      //   messagesにアクセスするクライアント操作（get()での参照）は成立しなくなる
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
        // ★ 2通目以降も含め、メッセージを送るたびに毎回ブロック関係を確認する
        //   （スレッド作成後にブロックされた場合でも、以降の送信は拒否される）
        allow create: if isSignedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants &&
          !isBlockedEitherWay(otherParticipantOfThread(threadId)) &&
          !isRestricted();
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
        // ★ ダブルタップのハートリアクション（likedBy）だけは、参加者なら誰でも付け外しできる
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
      }

      // ★ 既読管理（Instagram DM風の「既読」表示用）。読んだ本人だけが自分のドキュメントを
      //   更新できる。読み取りは同じスレッドの参加者同士でのみ（相手が既読かどうかを見るため）
      match /reads/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
        allow write: if isSelf(uid);
      }
    }

    // ── posts/{postId}（タイムライン投稿） ───────────────────────
    // ★ 非公開アカウント（鍵垢）対応：投稿者がisPrivateAccount=trueの場合、
    //   投稿者本人か、投稿者を実際にフォローしている人にしか読み取りを許可しない。
    //   クライアント側のフィルタだけに頼らず、ここで実際に制御する。
    //   ★ 以前はget()で投稿者のuserドキュメントを毎回参照していたが、絞り込み条件の無い
    //     全件購読クエリ（PostViewModel.startListeners）と組み合わさると、Firestoreが
    //     「このクエリはルールを満たさない結果を返しうるか」をクエリ自体の条件だけから
    //     静的に証明できず、購読そのものが丸ごと権限エラーになってしまっていた。
    //     投稿ドキュメント自身にauthorIsPrivateを非正規化して持たせ、それをそのまま
    //     resource.dataから直接見るようにすることで、
    //     「where authorIsPrivate == false」というクエリ条件だけでルールを満たすことを
    //     Firestoreが証明できるようにした（PostModel.authorIsPrivateのコメントも参照）
    function followsAuthor(authorUid) {
      return exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorUid));
    }

    // ★ 投稿者本人が設定した「コメント許可」設定(users/{uid}.commentPermission)を見て、
    //   コメントを許可してよいか判定する。フィールド未設定（設定画面が入る前の既存ユーザー）は
    //   'everyone'扱いにして、後方互換を保つ
    function canCommentOn(postAuthorUid) {
      return postAuthorUid == request.auth.uid ||
        (
          get(/databases/$(database)/documents/users/$(postAuthorUid)).data.get('commentPermission', 'everyone') == 'everyone'
        ) ||
        (
          get(/databases/$(database)/documents/users/$(postAuthorUid)).data.get('commentPermission', 'everyone') == 'followers' &&
          followsAuthor(postAuthorUid)
        );
    }

    match /posts/{postId} {
      allow read: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid ||
          resource.data.authorIsPrivate != true ||
          followsAuthor(resource.data.authorUid));
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && !isRestricted();
      // ★ いいね（likedBy配列）の更新は誰でもできる必要があるが、他人の投稿本文・画像を
      //   書き換えられないよう、authorUid・mediaURLは変更不可にする。
      //   ★ commentCountは、コメント追加・削除のたびにFieldValue.increment(±1)で
      //   更新される非正規化カウンタ（PostCommentViewModel参照）。以前は値の妥当性を
      //   一切見ておらず、対応するコメントを1件も作らずに任意の数値へ書き換えられてしまっていた。
      //   実際のコメント作成・削除と同じ「1回の変化は必ず±1」という制約をルール側でも強制する
      //   ★ captionのみ、投稿者本人に限って編集を許可する（画像・動画・投稿先グループ等は
      //   変更不可のまま。マイページの「…」メニューからのキャプション編集用）
      allow update: if isSignedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'commentCount']) &&
          request.resource.data.commentCount >= 0 &&
          (request.resource.data.commentCount == resource.data.commentCount ||
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1)
        ) ||
        (
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
        )
      );
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && !isRestricted()
          && canCommentOn(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid);
        allow delete: if isSignedIn() &&
          (resource.data.authorUid == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
        allow update: if false;
      }
    }

    // ── 本人のデータだけを読み書きする系（推し活費用・持ち物チェックリスト） ──
    match /oshiExpenses/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /packingChecklistItems/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ── memoryDiaries（カレンダーの日付長押しから書く、本人だけの思い出日記） ──
    match /memoryDiaries/{docId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── packingTemplates（自分専用の持ち物テンプレート。他ユーザーの投稿から
    //   保存する場合も、保存する本人のuidで新規ドキュメントが作られるだけなので
    //   このルールで問題なくカバーできる） ──
    match /packingTemplates/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ── eventAttendance（参戦記録。「参戦しましたか？」の回答を1予定につき1件持つ） ──
    match /eventAttendance/{docId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // ★ answer()はsetData()で新規作成・上書きの両方を行うため、
      //   ドキュメントが未作成の初回はupdateではなくcreateとして評価される
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    // ── storeKitAccountTokens（StoreKitのappAccountToken → uid の対応表） ──
    // ★ プレミアム購入時にSubscriptionManager.swiftが生成するUUID(appAccountToken)を
    //   StoreKitの購入オプションに添えておくことで、アプリを開いていない間にAppleが
    //   プッシュしてくるApp Store Server通知（functions/index.js: appStoreNotifications）
    //   から「どのFirebaseユーザーの購入か」をCloud Functions側（Admin SDK、このルールを
    //   経由しない）で逆引きできるようにする。クライアントは自分のuidを値にした
    //   登録（作成・自分のトークンの更新）だけができ、読み取りはできない
    //   （読む必要があるのはCloud Functionsだけで、クライアントには不要な情報のため）
    match /storeKitAccountTokens/{token} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow read, delete: if false;
    }

    // ── follows（フォロー関係） ───────────────────────────────────
    match /follows/{docId} {
      allow read: if isSignedIn();
      // ★ 通常は本人（followerUid）が自分でフォローする時に作成するが、非公開アカウントの
      //   フォローリクエストを承認する時は、承認する側（followingUid）が代わりに作成する。
      //   その場合、対応するfollowRequests（fromUid=followerUid, toUid=followingUid）が
      //   実際に存在していたことを条件にする（勝手に「フォローされたことにする」ことを防ぐ）。
      //   FollowViewModel.acceptFollowRequestはfollows作成とfollowRequests削除を
      //   同じバッチで原子的に行うため、このexists()は削除前の状態を見て判定できる
      allow create: if isSignedIn() && (
        request.resource.data.followerUid == request.auth.uid ||
        (
          request.resource.data.followingUid == request.auth.uid &&
          exists(/databases/$(database)/documents/followRequests/$(request.resource.data.followerUid + '_' + request.resource.data.followingUid))
        )
      );
      allow delete: if isSignedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    // ── followRequests（非公開アカウントへのフォローリクエスト） ──
    // ★ 送った本人(fromUid)と受け取った本人(toUid)だけが読み書きできる。
    //   作成は送った本人のみ。削除は、送った本人（取り消し）または受け取った本人
    //   （承認・拒否のどちらでも、リクエスト自体はここで消える）ができる
    match /followRequests/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // ── savedPosts（投稿の保存/ブックマーク。本人だけが読み書きできる） ──
    match /savedPosts/{docId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── notifications（アプリ内通知） ─────────────────────────────
    match /notifications/{docId} {
      allow read, update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      // ★ フォロー通知など「他人あてに」作成するケースがあるため、recipientUidは制限しない。
      //   ただしactorUid(通知を発生させた本人)は必ず自分自身にする(なりすまし防止)
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // ── venueReports（会場の口コミ・セトリ） ──────────────────────
    match /venueReports/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && !isRestricted();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── イベントハブの追加情報（チケット・グッズ・お知らせ） ──────
    match /eventTickets/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && !isRestricted();
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow update: if false;
    }
    match /eventGoods/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && !isRestricted();
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow update: if false;
    }
    match /eventAnnouncements/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid && !isRestricted();
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow update: if false;
    }

    // ── events / privateEvents（コミュニティカレンダーの予定） ────
    // ★ 荒らし対策（2026/08/03追加）：予定の追加はグループメンバーなら誰でも自由にできる
    //   （推し活情報の共有はコミュニティの価値なので、ここは制限しない）。
    //   ただし編集・削除ができるのは「その予定を追加した本人」と「グループの管理者・オーナー」だけに
    //   限定し、他のメンバーが勝手に人の予定を消したり、書き換えたりできないようにする。
    //   （チャットメッセージの削除権限＝送信者本人 or 管理者、と同じ考え方に揃えている）
    match /events/{docId} {
      allow read: if isSignedIn();
      allow create: if isGroupMember(request.resource.data.groupId) &&
        request.resource.data.creatorUid == request.auth.uid;
      // ★ コミュニティカレンダーの承認制（2026/08/10追加）：グループメンバーなら誰でも、
      //   approvedBy配列に「自分自身のuidを足すだけ」の更新ができる（他人を外す・
      //   他のフィールドを書き換えることはできない）。それ以外の更新は、
      //   その予定を追加した本人 or グループの管理者・オーナーだけに引き続き限定する
      //
      // ★ 承認待ち一覧の「削除」／カレンダーからの「削除」（2026/08/11追加）：
      //   どちらも「自分のカレンダー・自分の承認待ち一覧からだけ消える」個人の意思表示であり、
      //   誰か1人の操作が他メンバーに影響してはいけない。そのため以下の2パターンも
      //   グループメンバーなら誰でも行える追加の更新として許可する。
      //   ① dismissedByに自分のuidを足すだけ（承認待ち一覧の「削除」＝EventViewModel.dismissApprovalEvent）
      //   ② approvedByから自分のuidを1件だけ外し、同時にdismissedByに自分のuidを足す
      //     （カレンダー本体からの「削除」＝EventViewModel.deleteEventのコミュニティ分岐）
      allow update: if isGroupMember(resource.data.groupId) &&
        (
          resource.data.creatorUid == request.auth.uid || isGroupAdmin(resource.data.groupId) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy']) &&
            request.resource.data.approvedBy.hasAll(resource.data.approvedBy) &&
            request.auth.uid in request.resource.data.approvedBy
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedBy']) &&
            request.resource.data.dismissedBy.hasAll(resource.data.get('dismissedBy', [])) &&
            request.auth.uid in request.resource.data.dismissedBy
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy', 'dismissedBy']) &&
            request.auth.uid in resource.data.get('approvedBy', []) &&
            !(request.auth.uid in request.resource.data.approvedBy) &&
            resource.data.approvedBy.hasAll(request.resource.data.approvedBy) &&
            request.resource.data.approvedBy.size() == resource.data.approvedBy.size() - 1 &&
            request.resource.data.dismissedBy.hasAll(resource.data.get('dismissedBy', [])) &&
            request.auth.uid in request.resource.data.dismissedBy
          )
        );
      allow delete: if isGroupMember(resource.data.groupId) &&
        (resource.data.creatorUid == request.auth.uid || isGroupAdmin(resource.data.groupId));
    }

    // ★ 秘密の予定（isSecret）は「本人にしか見えない」個人用メモという位置づけなので、
    //   グループの権限とは無関係に、常に作成者本人だけに限定する。
    //   以前は isSignedIn() だけだったため、他人のドキュメントIDさえ分かれば
    //   秘密の予定でも読み書きできてしまう抜け穴があった。合わせて締める
    match /privateEvents/{docId} {
      allow read: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }
    match /calendars/{docId} {
      // ★ 読み取り：コミュニティカレンダーはそのグループのメンバーなら誰でも、
      //   個人カレンダーはmemberIdsに入っている人だけ（以前はisSignedIn()だけで、
      //   他人の個人カレンダーの名前・メンバー構成まで誰でも読めてしまっていた）
      allow read: if isSignedIn() &&
        (resource.data.isCommunity == true
          ? isGroupMember(resource.data.groupId)
          : request.auth.uid in resource.data.memberIds);

      // ★ 作成：コミュニティカレンダーはグループメンバーなら作れる
      //   （createCommunityCalendarIfNeeded）。個人カレンダーは作成者自身がグループの
      //   メンバーであり、かつownerId・memberIdsに自分自身を含めていることを要求する
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId) &&
        (request.resource.data.isCommunity == true
          || (request.resource.data.ownerId == request.auth.uid &&
              request.auth.uid in request.resource.data.memberIds));

      // ★ 更新：個人カレンダーはmemberIdsに入っている人なら誰でも改名・メンバー変更できる
      //   （renameCalendar/updateCalendarMembers参照。アプリの仕様として共有カレンダーは
      //   メンバー全員が対等に管理できる）。コミュニティカレンダーはクライアントから
      //   更新する機能自体が無いため常に不可にする。プライベートカレンダーも同様に
      //   「誰も招待できない」を担保するため、memberIds等の更新自体を一切許可しない
      allow update: if isSignedIn() &&
        resource.data.isCommunity != true &&
        resource.data.get('isPrivate', false) != true &&
        request.auth.uid in resource.data.memberIds;

      // ★ 削除：個人カレンダーのメンバーのみ（コミュニティ・プライベートは常に不可。
      //   クライアント側でもdeleteCalendar()が同様にガードしている）
      allow delete: if isSignedIn() &&
        resource.data.isCommunity != true &&
        resource.data.get('isPrivate', false) != true &&
        request.auth.uid in resource.data.memberIds;
    }

    // ── messageReports（通報） ────────────────────────────────────
    // ★ 通報はモデレーション用データなので、アプリ側からは書き込みのみ許可し、
    //   一覧の閲覧・編集はクライアントからは一切できないようにする
    //   （確認はFirebaseコンソール、または将来の管理者専用画面から行う想定）
    match /messageReports/{docId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── pushTriggers（プッシュ通知の配信トリガー） ─────────────────
    // ★ このコレクションへの書き込みをきっかけに、Cloud Functions（functions/index.js の
    //   sendPushOnTrigger）が実際のFCM送信を行う（PushNotificationService.swift参照）。
    //   topicは必ず"user_{uid}"の形（クライアントは生のデバイストークンを一切扱わない）。
    //   閲覧・更新・削除はクライアントから一切できない（Cloud Functions側のAdmin SDKは
    //   このルールを経由せずアクセスできるため、送信後の削除等も問題なく行える）
    match /pushTriggers/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.topic is string
        && request.resource.data.topic.matches('user_.+')
        && request.resource.data.notification.title is string
        && request.resource.data.notification.body is string;
      allow read, update, delete: if false;
    }

    // ── その他すべて：デフォルト拒否 ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
